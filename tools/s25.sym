# PM2525 S25 symbol file for dis8051.py
# NOTE: bus A here = "bus B (option)" and bus B here = "bus A (internal)" in manuals/06_option_bus_protocol_hardware_notes.md
code 0x0000 reset_vector
code 0x51FA start            entry

# JMP @A+DPTR tables (first entry, count, stride)
jtab 0x35C7 0x35C8 15 3
jtab 0x1D78 0x1D79 5 2
jtab 0x1662 0x1663 16 2
jtab 0x10E8 0x10E9 16 2
jtab 0x7B05 0x7B06 12 3
jtab 0x7866 0x7867 12 3
jtab 0x1CA2 0x1CA3 4 2

# ---------------------------------------------------------------- boot / main
code 0x002B main_loop            # main super-loop; re-inits SP each pass, polls interface, runs all tasks
code 0x00E4 iface_select_pending # pick pending interface channel (xdata 0x56/0x53) into ptr 1Dh:1Eh
code 0x5226 iface_boot_handshake # power-up handshake with interface board (I2C bus A, 0x58..)
code 0x5275 read_option_switches # reads option/config byte via 5ACF, stores flags 23h.2/23h.3
code 0x5295 system_init          # IE/TCON/SCON off, clear IRAM 08..5F, init state, LCD test pattern
code 0x5344 i2c_both_buses_stop  # release both bit-banged I2C buses

# ---------------------------------------------------------------- I2C bus A (SDA=P1.1, SCL=P3.2/INT0)
# devices: 0x4E PCF8574 (read/write), 0x58-0x5E interface-board controller
code 0x6354 i2cA_read1          # A=addr: start+addr(R), read 1 byte w/ NACK, stop. C=1 on no-ack
code 0x6363 i2cA_write1         # A=addr, R3=data: start+addr(W), send, stop
code 0x6359 i2cA_recv_nack_stop
code 0x635C i2cA_nack_stop
code 0x6369 i2cA_send_stop      # send A then stop
code 0x6377 i2cA_start_write    # start + addr (R/W=0); C=1 if NACK
code 0x6388 i2cA_start_read     # start + addr (R/W=1); C=1 if NACK
code 0x6397 i2cA_send_byte      # 8 bits MSB first, waits for clock stretching, returns ACK in C
code 0x63AD i2cA_read_ack_bit
code 0x63C8 i2cA_stop
code 0x63DD i2cA_recv_ack       # receive byte then send ACK
code 0x63E1 i2cA_send_ack
code 0x63FA i2cA_recv_byte

# ---------------------------------------------------------------- I2C bus B (SDA=P1.7, SCL=P3.5/T1)
# devices: 0x70 PCF8576 LCD driver, 0x48 PCF8574, 0x80/82/84/8B(w) 8D(r) OQ0071 ADC interface
code 0x6B3A i2cB_recv_nack_stop
code 0x6B44 i2cB_write1         # A=addr, R3=data
code 0x6B4A i2cB_send_stop
code 0x6B55 i2cB_start_write
code 0x6B62 i2cB_start_read
code 0x6B64 i2cB_start          # start condition + address byte (ACC.0 = R/W)
code 0x6B6F i2cB_send_byte
code 0x6B81 i2cB_read_ack_bit
code 0x6B8F i2cB_stop
code 0x6B9B i2cB_read1
code 0x6BB0 i2cB_recv_byte

# ---------------------------------------------------------------- serial shift registers (share P1.7/T1)
code 0x5A8D shiftreg_write_analog # shift out IRAM 08h,09h on P1.7/T1, latch with P1.3. 09h.1 = switch-motor direction, 08h.4 strobe
code 0x5AA3 shiftreg_out_byte
code 0x5AB2 funcswitch_read_pos    # shift in 8 bits from P1.0 = function-switch position (motor-driven rotary switch)

# ---------------------------------------------------------------- tasks called by main_loop
code 0x7BDA iface_poll_channel  # DPTR=channel descriptor (xdata); service interface board
code 0x7BF0 iface_send_channel
code 0x7C8E iface_receive_channel # returns C=1 when a byte/command arrived
code 0x7D01 iface_i2c_read_block
code 0x7D26 iface_i2c_write_block
code 0x7F3E iface_i2c_addr      # address = 0x58 | ((R4>>4)&6)
code 0x543C task_remote_parse      # swap in parser context (XDATA 0x00DB, 13 bytes + float 0x01D1) and run one parser step
code 0x2AA9 task_display_menu   # 1385 B: display/CHECK menu (ADDr, rTL, T.ONLY, Cr, 60H, SOFT, CAL, version)
code 0x409C task_keyboard       # 1906 B: key handling / function+range selection state machine
code 0x5468 task_5468           # uses P1.6
code 0x5D96 task_5D96
code 0x5D02 task_5D02
code 0x1009 task_measure        # 1965 B: measurement sequencing, timers T0/T1, ADC cycles
code 0x326C task_display_update # every 50 main-loop passes (24h.1): result -> LCD
code 0x4D2B task_remote_reply   # 1228 B: builds interface replies (command table at 0x59B1)

# ---------------------------------------------------------------- remote command helpers
code 0x4968 reply_put_mnemonic  # append 3-char mnemonic #(33h) from table 0x59B1 to reply buffer
code 0x49B7 reply_put_string    # append '#'-terminated code string at (2Dh:2Eh)
code 0x59B1 cmd_table           # 5-byte entries: 3 chars + 2 code bytes. VPU..CON functions, then FNC,RNG,...

# ---------------------------------------------------------------- display
code 0x5CA7 lcd_show_message    # DPTR -> message in table 0x70E4 ('#'-terminated, 11 chars)
code 0x37F5 lcd_refresh
code 0x70E4 msg_table           # " -------", " -OL----", " -UL----", "FAIL", " -OFL---", "Error", "ADDr -", ...
code 0x6DAB reply_strings       # "OFF,", " ON,", CLOSED/OPEN/AUTO/... reply fragments
code 0x59A6 version_string      # "PM25253 S25"

# ---------------------------------------------------------------- interrupts
code 0x534D isr_timer0          # Timer 0 overflow
code 0x5398 isr_int1_gate        # INT1 edge: stop T0, start T1 with reload (time/frequency gate); not ADC READY
code 0x53B8 isr_timer1          # Timer 1 overflow

# ---------------------------------------------------------------- runtime helpers
code 0x6D78 dptr_add_a          # DPTR += A
code 0x6D8C dptr_add_a_mul_b    # DPTR += A*B (table index)
code 0x6D81 dptr_add_r6r7       # DPTR += R6:R7

# ================================================================ measurement (task_measure, 0x1009)
# State: IRAM 20h = meter state: bits0-3 function, bits4-6 range, bit7 autorange (boot value 0xA1).
# task_measure swaps 14 bytes of context XDATA 0x00BE..0x00CB <-> IRAM 2Ah..37h (bit flags 2Ah.0-2Fh.7) on entry/exit.
# Phase flags: 2Ch.0 = function-switch/relay setup, 2Ch.1 = acquisition, 2Ch.2 = result processing.
code 0x107F meas_ctx_ptr           # DPTR=0x00BE, R0=0x2A, R2=14: measurement context descriptor
code 0x1072 meas_exit              # save context back to XDATA and return
code 0x10A6 meas_restart           # restart the measurement sequence (clears 23h.0, sets 22h.3)
code 0x1087 meas_init              # power-up init of measurement engine (EA off, flags, calls 10D1/5BCB)
code 0x10A0 meas_restart_from_ui   # called from keyboard / task_5468 after a function or range change
code 0x10AC meas_restart_b         # same, called from 3CC3
code 0x259E meas_phase_switch      # drive motor switch to table position (funcswitch_pos_table), set relays, settle
code 0x213B meas_phase_acquire     # start acquisition; branches per function: 0->2201, 8->238C, 9->23E1, 10->24FF, else ADC 22CE
code 0x2092 meas_phase_process     # process finished conversion: scale, autorange, filter, store
code 0x2352 adc_wait_ready_read    # poll INT1 pin (OQ0071 READY, active low), read 0x8D -> count in 10h:0Fh:0Eh
code 0x29C2 funcswitch_pos_table   # function -> required switch position (bit1 = range-dependent)
code 0x211D diag_count_event       # A = event id: ++XDATA[0x0772+A], ++XDATA[0x076C]. 0x0A,0x0B (ADC timeout),0x0C (no phase)
code 0x1145 meas_scale_result      # converts raw count to value using range constants (0x7040..) and float math
code 0x1487 meas_process_special   # processing for modes 25h.1 / 2Dh.3 / 2Dh.6 (peak/temperature?)
code 0x1515 meas_process_func8     # result processing for function 8 (timer-based measurement)
code 0x1C86 freq_autorange         # function 10 only: gate-time autorange, thresholds 90/103, 900/1003 counts
code 0x1C63 meas_range_checks      # calls 1BB7/1C20/1AC0/1AFE/1B74 (over/under-range handling?)
code 0x19A8 range_param_lookup     # per-range constants (tables 0x6FE9..0x7031)
code 0x182C result_store           # store float result to XDATA 0x00F2
code 0x287F timer0_start_settle    # T0 as settle timer (27h.5 mode: ISR kicks watchdog P1.2)
code 0x298C timer1_setup_count
code 0x21D7 freq_gate_setup        # INT1 edge gate + T0/T1 for time/frequency functions

# ================================================================ OQ0071 ADC interface (I2C bus B, group address 8)
code 0x14A2 adc_start_cycle        # cmd 0x89 (or 0x8B if 26h.6) then PCF8574@0x4E bit0 = !26h.6
code 0x21B1 adc_start_cycle_alt    # cmd 0x8B if 26h.6 else adc_start_cycle
code 0x2560 adc_arm_timeout        # timeout counter 12h/13h = 0x0420 passes, set busy flags 2Eh.3/25h.0/2Eh.1
code 0x256D adc_write_latches      # cmd 0x80, 0xD0, IRAM 0Ah = 8 output latches (input sensitivity, beeper)
code 0x2573 adc_latch_cmd_begin
code 0x2580 adc_set_times          # cmd 0x82 + R6,R5 = wait time T1; if F0=0 also 0x84 (count time T2)
code 0x2591 adc_set_count_time     # cmd 0x84 + R6,R5 = count time T2

# ================================================================ interrupts (details)
# isr_timer0: 27h.5 = settle-timer mode (pulses P1.2 watchdog, counts 1Bh); 25h.1 = count extension (++0Fh);
#             function 8: gate toggling via TXD pin; function 10: ++10h.
# isr_timer1: function 8: 32-bit overflow count in 0Fh..11h; function 9 gated; else period sampling into 16h..18h.

# ================================================================ data helpers
code 0x6D1E xdata_clear3
code 0x6D25 xdata_is_zero3         # C=1 if 3 bytes at DPTR are zero
code 0x6D34 xdata_to_iram          # copy R2 bytes XDATA@DPTR -> IRAM@R0
code 0x6D3B iram_to_xdata          # copy R2 bytes IRAM@R0 -> XDATA@DPTR
code 0x6D42 xdata_swap_iram        # exchange R2 bytes
code 0x6D4A xdata_block_xfer

# ================================================================ float library
# Format: 4 bytes, byte0 = sign(bit7) | exponent(bias 62), bytes1-3 = mantissa with explicit leading 1:
#   value = m/2^24 * 2^(e-62). Zero = exponent byte 0. In IRAM the exponent byte is at the highest
#   address and R0/R1 point at it. Examples: 4C9C3C00 = 9999, 31D1B717 = 1e-4, 66E8D4A4 = 1e12.
code 0x657D fp_add                 # @R0 += @R1
code 0x656F fp_sub                 # @R0 -= @R1 (negate R1, add)
code 0x6577 fp_rsub                # @R0 = @R1 - @R0
code 0x66EA fp_mul                 # @R0 *= @R1
code 0x664C fp_div                 # @R0 /= @R1; C=1,OV=1 on divide by zero
code 0x6767 fp_cmp                 # compare @R0 with @R1 -> C
code 0x67AB fp_copy_r1_to_r0
code 0x686B fp_swap
code 0x67C0 fp_ld_code_r0          # @R0 = float from code @DPTR
code 0x67D0 fp_ld_code_r1
code 0x6884 fp_ld_xdata_r0
code 0x6893 fp_ld_xdata_r1
code 0x68A2 fp_st_r0_xdata
code 0x68B1 fp_st_r1_xdata
code 0x68CB fp_ld_pow10_r1         # @R1 = 10^A, A = -18..19 (table 0x68DF)
code 0x68DF pow10_table            # 38 floats 1e-18 .. 1e19
code 0x6C02 mant_mul24             # 24x24 mantissa multiply (used by fp_mul)
code 0x6FC0 const_fp_table         # +max, -max, -1e12, +1e12, tiny, 1e-4, 9999, 600, ...

# ================================================================ 24-bit integer helpers
code 0x6AD1 i24_clr_r0
code 0x6ADC i24_clr_r1
code 0x6AF1 i24_cmp                # @R0 - @R1 -> C (and zero test)
code 0x6B26 i24_ld_code_r1
code 0x6BCE i24_st_r0_xdata
code 0x6BE8 i24_ld_xdata_r0
code 0x6BF5 i24_ld_xdata_r1
code 0x69BE i24_div                # 24-bit restoring division

# ================================================================ function numbers (meter_state bits 0-3)
# 0 Vpeak (21h.7/21h.6: 01=Vp+ 10=Vp- 11=Vpp)   1 VDC   2 VAC   3 V rms (VRM)   4 ohm 4-wire (RFW)   5 ohm 2-wire (RTW)
# 6 IDC   7 IAC   8 time interval (21h.5 = start on neg. slope, 21h.4 = stop on neg. slope)
# 9 capacitance   10 frequency   11 temperature degC (Pt-100, TDC)   12 diode   13 continuity
code 0x4132 fnsel_dispatch         # 2Eh = command index 0..0x12 (VPU..CON) -> jump table fnsel_jtab
code 0x465D fnsel_jtab             # 19 x LJMP, one per function mnemonic
code 0x46F0 fnsel_apply            # 3Ah = new function number; applies it to meter_state
code 0x413E fnsel_VPU
code 0x4148 fnsel_VPL
code 0x4152 fnsel_VPP
code 0x415C fnsel_VDC
code 0x4162 fnsel_VAC
code 0x4168 fnsel_VRM
code 0x416E fnsel_RFW
code 0x4174 fnsel_RTW
code 0x417A fnsel_IDC
code 0x4180 fnsel_IAC
code 0x4186 fnsel_TPP
code 0x4190 fnsel_TPN
code 0x419A fnsel_TNP
code 0x41A4 fnsel_TNN
code 0x41AE fnsel_CAP
code 0x41B4 fnsel_FRQ
code 0x41BA fnsel_TDC
code 0x41C0 fnsel_DIO
code 0x41C6 fnsel_CON

# ================================================================ IRAM variables (outside the swapped context area 2Ah-37h)
data 0x08 shiftreg_out0            # analog shift register byte 0 (bit4 = strobe)
data 0x09 shiftreg_out1            # analog shift register byte 1 (bit1 = switch-motor direction)
data 0x0A adc_latch_byte           # OQ0071 output latches
data 0x0E adc_count_lo
data 0x0F adc_count_mid
data 0x10 adc_count_hi
data 0x12 adc_timeout_lo
data 0x13 adc_timeout_hi
data 0x20 meter_state              # bits0-3 function, bits4-6 range, bit7 autorange
data 0x3A fnsel_new_function
bit 0x0F peak_mode_b1              # 21h.7
bit 0x0E peak_mode_b0              # 21h.6
bit 0x0D time_start_negslope       # 21h.5
bit 0x0C time_stop_negslope        # 21h.4
bit 0x07 meter_autorange           # 20h.7
bit 0x36 adc_alt_mode              # 26h.6: start with 0x8B instead of 0x89

# ================================================================ XDATA variables
xdata 0x0034 reply_buf
xdata 0x00BE meas_ctx_save         # 14 bytes, swapped with IRAM 2Ah..37h
xdata 0x00F2 meas_result           # float
xdata 0x076C diag_err_total        # also counts copy-1 checksum errors
xdata 0x0772 diag_event_counters

# ================================================================ ranges
# value = count * 10^(range_scale_exp) ; exponent = per-function base + range (bits 4-6 of meter_state)
# IRAM 21h bits0-1 = SPEED setting: 0 = SPEED 1 (high resolution), 1 = SPEED 2 (normal, default), 2 = SPEED 3 (high speed)
code 0x165A range_scale_exp        # A = base(function) + range. Bases: Vpk -4, V -5, ohm -2, I -11 (-9 if 25h.6), time 0, C -14, f -3 (-4 in range 6), degC -1, diode -4, cont -2
code 0x16BA count_to_value         # 4Fh (i24 count) -> float * 10^range_scale_exp
code 0x194C range_can_go_up        # C=1 if range+1 is enabled in valid_range_masks
code 0x1959 range_can_go_down      # C=1 if range-1 is enabled (current on 25h.6 input: only from range 6/7)
code 0x1975 range_mask_test        # tests bit R0 of valid_range_masks[function*3 + speed]
code 0x6ED4 valid_range_masks      # 14 functions x 3 speeds, bit r = range r allowed
code 0x1AFE autorange_step         # compare count with 42h (down), 46h (up), 4Ah (overload); step meter_state range by +-0x10
code 0x1AC0 meas_prepare_count
code 0x6FE9 range_count_limits     # 24-bit count thresholds used by range_param_lookup (1800, 2000/2100, 10000/11000, 20000/21000, ...)
code 0x68C0 dptr_add_a_b           # DPTR += A
code 0x6B17 i24_ld_code_r0
code 0x6B05 i24_copy_r1_to_r0
bit 0x08 speed_b0                  # 21h.0
bit 0x09 speed_b1                  # 21h.1
data 0x21 meter_mode               # bits0-1 speed, bit4/5 time slopes, bit6/7 peak mode
data 0x42 range_lim_down           # i24
data 0x46 range_lim_up             # i24
data 0x4A range_lim_overload       # i24

# ================================================================ calibration
# Cal RAM (battery-backed): 3 identical copies of 456 bytes (114 float slots) + 16-bit additive checksum each:
#   copy1 0x0200-0x03C7 (sum 0x03C8), copy2 0x03CF-0x0596 (sum 0x0597), copy3 0x059E-0x0765 (sum 0x0766).
# Per range a ROM recipe (cal_recipe_table) names which slots form the 6 coefficients of 1 or 2 records:
#   K0 zero, K1 gain, K2 zero ref. temp, K3 gain ref. temp, K4 zero temp. slope, K5 gain temp. slope.
# Record 1 (table flag bit7) = second set swapped in for Vpeak/VDC/CAP (negative polarity: VPL, -20 VDC).
code 0x0111 cal_load_range         # verify/repair 3 copies, evaluate recipe of current range into cal_work_set0/1
code 0x03DD cal_eval_field         # evaluate one coefficient (mode 0-5) for all records of the recipe
code 0x0453 cal_f_zero             # mode 0: K0 = product of A pointers (default 0)
code 0x0496 cal_f_gain             # mode 1: K1 = B0 * B1.. / Bn (h0>>6 multiplies) (default 1)
code 0x051B cal_f_zero_tref        # mode 2: K2 = X (default 0.5)
code 0x054D cal_f_gain_tref        # mode 3: K3 = C0 (default 0.5)
code 0x057F cal_f_zero_tslope      # mode 4: K4 = product of C1.. (default 0)
code 0x05C2 cal_f_gain_tslope      # mode 5: K5 = from D (default 0)
code 0x0642 cal_adjust_slot        # calibration run: writes a newly measured value into the recipe's slot (mode 0-5)
code 0x06F0 cal_recipe_ptr         # DPTR = cal_recipe_table + cal_recipe_offsets[function] + range*4 (current, 25h.6: range+2)
code 0x0738 cal_recipe_offsets     # 14 x 16-bit offsets (ranges spill over into the next function's slice)
code 0x76A2 cal_recipe_table       # 4-byte entries: recipe pointer, flags (bit7 = 2 records)
code 0x0754 cal_record_layout      # field offsets of one record from header bytes h0 (2Eh), h1 (2Fh)
code 0x078A cal_next_ptr           # fetch next 16-bit pointer of the current record field
code 0x07A4 cal_ld_slot            # load a slot (XDATA) or ROM constant, with validity check
code 0x082D cal_addr_copy2         # DPTR += 0x01CF
code 0x0848 cal_addr_copy3         # DPTR += 0x039E
code 0x0877 cal_write_all_copies   # write value to all three copies, refresh the three checksums
code 0x091B cal_checksum_copy1     # B=0: store sum, else compare (sets 5Dh.0 on mismatch)
code 0x0955 cal_checksum_copy2
code 0x098F cal_checksum_copy3
code 0x09DD sum16_xdata            # 16-bit additive sum of R1:R0 bytes at DPTR -> R3:R2
code 0x09F0 cal_majority_repair    # byte-wise 2-of-3 vote over the copies, repairs the odd one, counts events
code 0x0B25 cal_ctx_save           # IRAM 39h..5Fh -> XDATA 0x07A2
code 0x0B34 cal_ctx_restore
code 0x12A2 cal_compute_effective  # temp-compensate set 0 (and set 1 for Vpeak/VDC/CAP)
code 0x12BD cal_temp_compensate    # zero_eff = K0 + K4*(T-K2), gain_eff = K1 + K5*(T-K3); T = internal_temp
code 0x132D cal_swap_sets          # exchange cal_work_set0 and cal_work_set1
code 0x1359 internal_temp_update   # new internal-temperature reading -> filtered internal_temp
xdata 0x0200 cal_data_copy1
xdata 0x03C8 cal_sum_copy1
xdata 0x03CF cal_data_copy2
xdata 0x0597 cal_sum_copy2
xdata 0x059E cal_data_copy3
xdata 0x0766 cal_sum_copy3
xdata 0x0119 internal_temp         # float, relative internal temperature (measured via Vpeak circuit)
xdata 0x015F cal_work_set0         # K0..K5 (6 floats) for the current range
xdata 0x0177 cal_zero_eff
xdata 0x017B cal_gain_eff
xdata 0x017F cal_work_set1
xdata 0x0770 cal_fallback_flags    # bits set when a coefficient used its default; also copy-2 repair counter
xdata 0x07A2 cal_ctx_save_area

# ================================================================ calibration run
# CAL key held at reset -> P3.1 (TXD) low -> cal_enable (22h.5). CAL ON,n / SHIFT CHECK n ENTER -> cal_mode (22h.6),
# cal_hot (27h.2) = n. ZERO key or TRG B,X -> trigger_pending (24h.3) -> each finished conversion runs the step.
code 0x3E5B cal_mode_enter         # sets cal_mode, autorange off
code 0x4449 cmd_cal                # CAL [ON[,n]|OFF] handler in task_keyboard (keyboard + remote share it)
code 0x5D96 task_trigger           # ZERO key / TRG: sets trigger_pending
code 0x0D8D cal_step_zero          # zero point: needs 3 stable readings (max 29); cold: K0 (+K2=T), hot: K4 slope
code 0x0EE6 cal_step_gain          # gain point: cold: K1 (+K3=T), hot: K5 slope
code 0x0EDF cal_fail               # A = fail code -> XDATA 0x0771, sets fail flag
code 0x0B3E cal_classify_input     # zero vs gain point, level window, polarity, allowed by flags -> codes 1..9
code 0x0B0B cal_point_flags        # flag byte of the recipe table entry (bit0 zero-cold,1 gain-cold,2 zero-Tref,3 gain-Tref,4 zero-hot,5 gain-hot,7 two sets)
code 0x0CA6 cal_nominal_value      # nominal full-scale value of the range (from range limits and scale)
code 0x0E1B cal_reading_stable
code 0x3385 lcd_format_reading     # value -> LCD text buffer XDATA 0x0000; 'r' at pos 8 in cal mode, "NC" when uncalibrated
bit 0x15 cal_enable                # 22h.5
bit 0x16 cal_mode                  # 22h.6
bit 0x3A cal_hot                   # 27h.2: 0 = CAL 0 (cold), 1 = CAL 1 (hot)
bit 0x23 trigger_pending           # 24h.3
xdata 0x076D cal_sum_err_copy2
xdata 0x076E cal_sum_err_copy3
xdata 0x076F cal_repair_copy1
xdata 0x0771 cal_fail_code          # last calibration fail code (cal_fail); also copy-3 repair counter

# ================================================================ remote command parser (0x77B6..0x7BCC, hand-written asm)
# Input line in XDATA iface_rx_buf (0x0013 + rx_index 0Ch); rx_count 0Dh: bit7 line present, bit6 end of message, bits0-5 chars left.
# Output token in parser context: 2Dh type, 2Eh command index, 2Fh flags (bit7 token ready, bit5 first param,
#   bits0-2 kind: 0 OFF, 1 ON, 2 integer, 3 integer(b), 4 number, 5 none, 6 query; 0x70 = mnemonic), 30h-33h value.
# cmd_table type byte: bit7 bare, bit6 second param after ',', bit5 query, bit4 mnemonic, bit3 number, bit2/1 integer, bit0 ON/OFF.
code 0x77B6 parser_step
code 0x7804 parser_reset
code 0x7AE9 parser_end_token
code 0x7B47 parser_emit_token      # 2Fh |= 0x80, wait for consumer
code 0x7BBE parser_getc            # A = iface_rx_buf[rx_index]
code 0x7B9A parser_is_letter
code 0x7BB5 parser_is_digit
code 0x3D6E cmd_param_first_char   # first character of a mnemonic parameter
code 0x3F8E cmd_fnc_lookup         # FNC <mnemonic>: find function mnemonic in cmd_table
code 0x4814 func_to_cmd_index      # current function -> mnemonic index (for FNC?, RSL)
code 0x3D7F set_speed              # MSP n
code 0x3F1D range_by_value         # RNG <number>
code 0x4061 dbm_set_reference      # DBM <number>: 1e-4..9999, stored at XDATA 0x0075 (default 600)
code 0x403A zer_set_reference      # ZER <number>
code 0x3E8B cdp_write_slot         # CDP n,value: cal slot n -> XDATA 0x0200+4(n-1), all three copies
code 0x5BBB rms_set_byte           # protected byte at 0x07FD (n, n+0x55, n-0x56)
code 0x5B93 rms_get_byte           # validate/repair, default 'A'
code 0x0ABF diag_clear_counters    # JCV (cal mode): clear 22 bytes from 0x076C
