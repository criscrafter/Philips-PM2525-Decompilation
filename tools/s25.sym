# ================================================================ CDP? dump / settings bytes
# Small triple-redundant settings area right after each cal-copy checksum: byte i at 0x03CA+i-1, 0x0599+i-1, 0x0768+i-1
#   byte 1 = interface options/GPIB address (IEE), byte 4 = cal seal: 'N' normal, 'a' altered (set by CDP S, cleared by CDP R)
code 0x5B1B nv_setting_read        # R2 = byte no.: 2-of-3 vote, repair; F0 = 1 if all copies differ
code 0x5B67 nv_setting_write       # write A to byte R2 in all three copies
code 0x5B74 cal_seal_check         # C=1 if seal byte = 'a' (cal data altered): ranges show NC, CDP? items flagged N
code 0x5B86 cal_seal_normal        # CDP R: seal byte = 'N'
code 0x5B8A cal_seal_altered       # CDP S: seal byte = 'a'
code 0x4921 cdp_load_slot          # load slot (vote over the 3 copies); 23h.7 if no majority -> 'E'
code 0x4A4F reply_put_3digits      # 3-digit decimal + ','
code 0x485A reply_put_float        # format float (e.g. +1.250000E+00)
code 0x49E3 reply_send
code 0x4A06 reply_send_last        # (+CR if CR ON) mark end of message, send
code 0x7C24 iface_send             # hand the reply buffer to the interface board
xdata 0x03CA nv_settings_copy1
xdata 0x0599 nv_settings_copy2
xdata 0x0768 nv_settings_copy3

# ================================================================ reading output (OUT S / OUT N)
# "<mnemonic><D|sp><Z|C|sp><flag> <value>": D = dB mode, Z = zero/relative, C = calibration mode.
# flag (priority): ? no reading yet, O overload, F cal fail, N not calibrated, U dB underflow,
#                  R reading not settled, C crest factor exceeded, blank = normal
code 0x4C58 reply_put_reading_header
code 0x4A84 reply_put_reading_value
code 0x1839 meas_build_status      # status byte 0 (56h): b0 crest(C) b1 overload(O) b2 cal fail(F) b3 unsettled(R) b4 uncal(N) b5 dB underflow(U) b7 no fresh conv.
code 0x18AF meas_publish_result    # 0x0064/0x0065 status, 0x0085 value (float), 0x0066 |= 1 on any error
code 0x3CD4 result_record_clear    # status1 bit3 = "no reading yet" ('?')
code 0x3CEE result_restart
code 0x1E6B meas_check_settled     # >9 unstable readings (29 in cal mode) -> 'R'
code 0x17AC result_apply_db_rel    # dB conversion (reference XDATA 0x0075) and zero/relative subtraction (0x0079)
xdata 0x0064 result_status0
xdata 0x0065 result_status1        # bits4-6 range, bit3 no reading yet, bit7 10 A input
xdata 0x0066 result_flags
xdata 0x0085 result_value

# ================================================================ interface link (option bus = i2cA), see manuals/06
code 0x7D88 iface_read_message     # header b7=0: n = b0-4 data bytes + checksum -> iface_rx_buf; b6 = END
code 0x7DA6 iface_rx_loop
code 0x7E18 iface_send_reply_block # header 0x20|len (b6 END), reply_buf, checksum
code 0x7E4F iface_send_identity    # E1: 0x60|len + version string (0x59A5) + checksum
code 0x7E86 iface_handle_event     # FE talk, E1 identity, FF countdown, F5-F8 remote/local, F9 GET, FA DCL, FB/FD resend
code 0x7F39 iface_write_ff         # FF = message received
code 0x7F45 iface_start_write
code 0x7F4B iface_start_read
code 0x7F51 iface_send_f4_address
code 0x7F56 iface_send_address     # C0 | GPIB address
code 0x7F5C iface_write_ctrl       # single control byte R5
code 0x7F63 iface_read_status      # read 1 (or 2 for 8x) status bytes
code 0x7F8C iface_send_status      # 0x80 | (2Eh & 0x3F)
code 0x7F9A iface_send_f1          # F1 xx
code 0x7FA7 iface_addressed
code 0x7FAE iface_mode_match
code 0x7FBA iface_send_byte_ck     # add + rotate-right checksum, then send
code 0x7FC1 iface_load_channel     # 3-byte channel descriptor (R4 config/address, R3 state, B flags) + context
code 0x7CEC iface_save_channel

# ================================================================ display (PCF8576 @ 0x70, internal bus) and keyboard (PCF8574 @ 0x48)
code 0x5549 lcd_send_frame         # text buffer XDATA 0x0000 -> segments; header C8 86 E0 F8 70, 13 data bytes, annunciators
code 0x57A2 lcd_encode_chars       # ASCII -> segment bytes via font, '.' merged into dp
code 0x580C lcd_font_7seg          # 96 entries for ASCII 0x20-0x7F: bit7 d, 6 c, 5 a, 4 b, 3 dp, 2 e, 1 f, 0 g
code 0x586C lcd_font_aux           # table for the 2-digit auxiliary field
code 0x532B lcd_test_pattern       # power-up all-segments pattern (25 bytes)
code 0x5934 key_scan               # debounced key number 0-15 -> 35h (FF = none)
code 0x5984 key_read_matrix        # PCF8574: write F0/read, write 0F/read, OR
code 0x5974 key_code_table         # 16 matrix codes
code 0x5A84 key_debounce_delay
code 0x2B31 key_jtab               # 16 x LJMP, key handlers store a command index for the executor
code 0x2B61 key_0_vdc_speed
code 0x2B87 key_1_vac_vrms
