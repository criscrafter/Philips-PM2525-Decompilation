code 0x2C3A key_11_zero
code 0x2C6D key_12_status
code 0x2C73 key_13_range_down
code 0x2C78 key_14_range_up
code 0x2C7C key_15_auto
xdata 0x0000 lcd_text_buf

# ================================================================ CHECK menu and stored settings
# SHIFT + key 14 = CHECK: [CAL 0/1 in cal-enable] or [rTL, ADDr, T.ONLY, Cr with interface] then 60H, SOFT.
# Settings bytes (nv_setting_*): 1 = iface config (b0-4 GPIB address, default 22; b7 talk-only),
#   2 = mains (0x55 = 60 Hz), 3 = CR (0x55 = on), 4 = cal seal.
code 0x5ACF nv_get_iface_config    # byte 1; invalid/31 -> 22 written back
code 0x5AE3 nv_set_iface_config
code 0x5AE9 mains_set_60hz         # SIX ON
code 0x5AF5 mains_set_50hz         # SIX OFF
code 0x5AED mains_load_setting
code 0x5B02 cr_set_on              # CR ON: append \r to output
code 0x5B0E cr_set_off
code 0x5B06 cr_load_setting
code 0x3FBA iee_store_address      # IEE n -> settings byte 1, tell the interface (C0|addr)
code 0x4006 tol_set                # TOL ON/OFF (talk only, byte 1 bit 7); keyboard T.ONLY step
code 0x3FF0 emo_set_count          # EMO n: output n readings (XDATA 0x0095)
code 0x3FDE rtl_go_local           # rTL: clear remote state in the interface context
code 0x3013 menu_show_step         # show a CHECK/edit menu message
bit 0x14 mains_60hz                # 22h.4: T1 gate 16.667 ms instead of 20 ms
bit 0x1D cr_enabled                # 23h.5
bit 0x1A emo_continuous            # 23h.2: EMO A
xdata 0x0095 emo_count

# ================================================================ measurement internals
code 0x2201 acq_vpeak              # Vpeak: T1=T2=0xF9A7, latch b5/b4 = +/- peak detector, up to 10 repeats, Vpp = both polarities
code 0x22CE acq_adc                # default ADC path; AC functions first run a two-phase RMS auto-zero (latch b6 / shiftreg 08h b7)
code 0x238C acq_time               # function 8
code 0x23E1 acq_cap                # function 9
code 0x24FF acq_freq               # function 10
code 0x2698 meas_setup_analog      # after the switch settles: load cal coefficients, wait time, analog config per function/range
code 0x29D0 analog_cfg_index       # 2 bytes per function: flags (b0 P3.1, b4 P1.4, b5 2Bh.3), base into analog_cfg_table
code 0x29EC analog_cfg_table       # 3 bytes per range: shiftreg 08h, 09h, ADC latch 0Ah
code 0x297D analog_cfg_flags
code 0x288E meas_calc_wait_time    # T1 (XDATA 0x00F0) from mains setting and function
code 0x27FA ac_autozero_phase_a
code 0x2838 ac_autozero_phase_b
code 0x1288 adc_count_minus_zero   # signed count = raw - T2 (29360, 2936 in SPEED 3); |count| >= T2 -> overload
code 0x16DC cal_apply              # value = (count - zero_eff) * gain_eff (set 1 for negative VDC, Vp-, CAP in SPEED 3)
code 0x16CC value_to_count         # inverse of count_to_value
code 0x1636 fast_mode_drop_digit   # SPEED 3 (and FRQ SPEED 2): count / 10
code 0x5C02 display_stabilize      # last-digit hysteresis against the previous count (XDATA 0x00D3/0x00D4)
code 0x1DE7 input_step_detect      # count jump > 10 (VDC, degC) or > 1000: restart averaging
code 0x7043 adc_count_time_norm    # 24-bit 29360
code 0x7046 adc_count_time_fast    # 24-bit 2936
xdata 0x00F0 adc_wait_time         # T1, 16-bit
xdata 0x00FA prev_count
xdata 0x00D3 stabilize_counter
xdata 0x00D4 stabilize_prev
xdata 0x0197 cal_zero_eff1
xdata 0x019B cal_gain_eff1

# ================================================================ timing functions (TMOD 0x15: T1 16-bit 1 us timer, T0 counts P3.4 edges)
code 0x23A1 time_arm               # P3.1 = start slope, T0 = FFFF (first edge overflows), enable T0/T1 interrupts
code 0x23C8 time_wait_stop         # start seen: stop-edge timeout 1Ch = 0xD7 passes
code 0x1515 meas_process_time      # seconds = (T1 overflows*65536 + T1) * 1e-6; decade autorange; cal (timebase) applied
code 0x14E9 time_read_counter
code 0x161F time_range_limit       # 10^(range-1) s * 1.1 (manual-range overload)
code 0x2413 cap_charge_start       # P1.5 low = discharge released, T1 times the charge until the comparator fires INT1
code 0x2485 cap_wait_charge        # overrange when T1 passes 0xD1xx (0x62xx in SPEED 3)
code 0x2A7F cap_range_table        # shift-register 09h per capacitance range
code 0x2502 freq_gate_start        # T0 counts input edges; T1 gate: 16 x 65.536 ms (1.048576 s), 2x in SPEED 2, 10 ms quick gate
code 0x2549 freq_gate_done
